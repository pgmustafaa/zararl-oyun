/* ---------- Modern Stil Dosyası (Güncellendi) ---------- */
/* Temel değişkenler - tema renklerini koruyoruz */
:root{
    --bg-color: #0a0a0a;
    --surface: #111215;
    --muted: #9aa0a6;
    --text-color: #f5f5f5;
    --accent: #ff3c00; /* orijinal tema rengi */
    --accent-2: #ff7a33;
    --glass: rgba(255,255,255,0.04);
    --radius: 12px;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
    margin:0;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
    background:linear-gradient(180deg,var(--bg-color),#070707);
    color:var(--text-color);
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
}

/* Page container */
.site-header{
    background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);
    backdrop-filter: blur(4px);
    border-bottom:1px solid rgba(255,255,255,0.03);
}
.container{
    max-width:1100px;
    margin:0 auto;
    padding:0 20px;
}

header .top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:18px 0;
}
.brand{
    display:flex;align-items:center;gap:12px
}
.brand h1{margin:0;font-size:1.25rem;color:var(--accent);letter-spacing:0.6px}
.brand small{color:var(--muted);font-size:0.8rem}

nav ul{list-style:none;margin:0;padding:0;display:flex;gap:18px;align-items:center}
nav a{color:var(--text-color);text-decoration:none;padding:8px 6px;border-radius:8px;transition:all .2s}
nav a:hover{color:#fff;background:rgba(255,255,255,0.02)}
nav a.active{background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#111;font-weight:600}

/* Mobile nav toggle */
.nav-toggle{display:none;background:transparent;border:0;color:var(--text-color);font-size:1.1rem}

/* Hero */
.hero{
    position:relative;
    padding:80px 0 60px 0;
    display:flex;align-items:center;justify-content:center;
    background-image:linear-gradient(180deg, rgba(10,10,10,0.45), rgba(10,10,10,0.7)), url('https://images.unsplash.com/photo-1511512578047-dfb367046420');
    background-size:cover;background-position:center;
}
.hero .hero-inner{max-width:980px;text-align:center;padding:40px;background:linear-gradient(180deg, rgba(0,0,0,0.25), rgba(0,0,0,0.2));border-radius:16px}
.hero h2{font-family: 'Poppins', system-ui, Arial; font-weight:700; font-size:2rem; margin:0 0 18px; color:var(--text-color); text-shadow:0 6px 22px rgba(0,0,0,0.6)}
.hero p{color:var(--muted);margin:0 0 20px}
.buttons{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn{background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#0b0b0b;padding:12px 20px;border-radius:10px;text-decoration:none;font-weight:600;box-shadow:0 6px 24px rgba(255,60,0,0.14);transition:transform .18s ease, box-shadow .18s}
.btn.secondary{background:transparent;color:var(--text-color);border:1px solid rgba(255,255,255,0.06)}
.btn:hover{transform:translateY(-4px);box-shadow:0 12px 34px rgba(255,60,0,0.18)}

/* Features */
.features{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:30px}
.card{background:var(--surface);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 6px 18px rgba(0,0,0,0.5)}
.card h3{margin:0 0 10px;color:var(--accent)}
.card p{margin:0;color:var(--muted);font-size:0.95rem}

/* Content area used by other pages */
.content{max-width:900px;margin:36px auto;padding:28px;background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);border-radius:12px;border:1px solid rgba(255,255,255,0.03)}
.content h2{color:var(--accent);margin-top:0}

/* Form styles */
form label{display:block;margin:12px 0 6px;color:var(--muted);font-size:0.95rem}
input[type=text],input[type=email],textarea{width:100%;padding:12px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--text-color)}
button[type=submit]{margin-top:12px}

/* Footer */
footer{padding:20px 0;text-align:center;color:var(--muted);font-size:0.9rem}

/* Small helpers */
.muted{color:var(--muted)}

/* Responsive */
@media (max-width:900px){
    .hero{padding:60px 0}
    .hero h2{font-size:1.5rem}
}
@media (max-width:720px){
    .nav-toggle{display:block}
    nav ul{display:none;position:absolute;top:64px;right:20px;background:var(--surface);padding:12px;border-radius:10px;box-shadow:0 6px 26px rgba(0,0,0,0.6)}
}

/* Theme support (light mode) keeping accent */
.light-mode{
    --bg-color:#f7f8fa;--surface:#ffffff;--text-color:#0b0b0b;--muted:#5b6166
}
